# ==========================================
# deploy-ops Configuration
# ==========================================

# ------------------------------------------
# 1. Application Variables
# (Typically provided by the application CI pipeline)
# ------------------------------------------
SERVICE_NAME=example-service
DEPLOY_VERSION=abc1234
# Optional: defaults to $SERVICE_NAME if not set
IMAGE_NAME=example-service
REGISTRY_IMAGE=gcr.io/my-project/example-service
DOCKERFILE=deploy/Dockerfile
BUILD_CONTEXT=.

# ------------------------------------------
# 2. Shared Infrastructure Context Variables
# (Provided securely via the `deploy-ops` CI context)
# ------------------------------------------
# Ephemeral Auth Key for joining the Tailscale deployment network
TAILSCALE_AUTH_KEY=tskey-auth-xxxxxx
# MagicDNS or 100.x.y.z IP of the Private VM
DEPLOY_HOST=my-vm-hostname
DEPLOY_USER=deploy

# ------------------------------------------
# 3. Environment Handling
# ------------------------------------------
# A file inside the app repo listing which variables to copy from CircleCI Context
ENV_DECLARATION_FILE=.env.example
# Alternative: Direct path to a pre-generated runtime .env file
# DEPLOY_ENV_FILE=/tmp/runtime.env

# ------------------------------------------
# 4. Optional Runtime Configuration
# ------------------------------------------
# Use these only if your application specifically needs them
DOCKER_NETWORK=bridge
HOST_PORT=8080
CONTAINER_PORT=8080
HEALTHCHECK_URL=http://localhost:8080/health
HEALTHCHECK_TIMEOUT=30
HEALTHCHECK_RETRIES=3
