# Default configuration for deploy-ops
# These can be overridden by environment variables

set -a

# Build context defaults
BUILD_CONTEXT=${BUILD_CONTEXT:-.}
DOCKERFILE=${DOCKERFILE:-Dockerfile}

# Network defaults
DOCKER_NETWORK=${DOCKER_NETWORK:-bridge}
RESTART_POLICY=${RESTART_POLICY:-always}

# Registry defaults (optional, depends on implementation)
# REGISTRY=gcr.io
# REGISTRY_USERNAME=
# REGISTRY_PASSWORD=
IMAGE_NAME="${IMAGE_NAME:-${SERVICE_NAME:-}}"
REGISTRY_IMAGE="${REGISTRY_IMAGE:-${REGISTRY:-}/${GCP_PROJECT_ID:-}/${IMAGE_NAME:-}}"

# Remote defaults
DEPLOY_USER=${DEPLOY_USER:-deploy}
# DEPLOY_HOST=

# Healthcheck defaults
HEALTHCHECK_TIMEOUT=${HEALTHCHECK_TIMEOUT:-30}
HEALTHCHECK_RETRIES=${HEALTHCHECK_RETRIES:-3}

set +a
